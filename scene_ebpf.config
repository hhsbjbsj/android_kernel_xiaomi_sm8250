# Scene-Port-Hider-by-eBPF kernel capability fragment
# Verified upstream baseline: AstideLabs/android_kernel_xiaomi_sm8250
# android17-aptusitu @ 89f281b6ac61d1819276a34e405761f3b1d64dcf
#
# This is intentionally limited to the generic kernel facilities required by
# the public Scene eBPF program: BTF/CO-RE support, cgroup sock_addr programs,
# and kprobe/kretprobe attachment. Device-specific functionality is untouched.

CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y

CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_EVENTS=y

CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SYSFS=y
